{
  "name": "letsclean",
  "version": "0.1.0",
  "description": "OmniDiskSweeper-style terminal disk usage explorer",
  "type": "module",
  "bin": {
    "letsclean": "dist/index.js"
  },
  "scripts": {
    "start": "node src/index.ts",
    "build": "node-gyp rebuild --directory native && tsc",
    "rebuild": "node-gyp rebuild --directory native",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "node-gyp": "^13.1.0",
    "typescript": "^5.9.0"
  }
}
